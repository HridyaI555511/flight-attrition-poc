# SAP SuccessFactors — SFSF Instance
SFSF_BASE_URL=https://<your-sfsf-host>
SFSF_COMPANY=<company-id>
SFSF_USERNAME=<username>
SFSF_PASSWORD=<password>

# OAuth2 SAML Bearer (production) — leave blank to fall back to Basic Auth
# Steps: SF Admin → OAuth2 Client Applications → Add Application
# Set "Allow unsigned assertion" = true, copy the Client ID below.
SFSF_OAUTH_CLIENT_ID=

# SAP SuccessFactors — Payroll Instance
PY_BASE_URL=https://<your-payroll-host>
PY_COMPANY=<company-id>
PY_USERNAME=<username>
PY_PASSWORD=<password>

# GitHub Token (for GitHub Models / GPT-4o — free with Copilot access)
# Get yours at: https://github.com/settings/tokens → Generate new token (classic)
# No special scopes needed.
GITHUB_TOKEN=ghp_...
